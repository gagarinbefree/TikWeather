{
  "name": "tikweather",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e",
    "build:android": "npm run typecheck && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:connected": "node src/tests/run-connected-chrome.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "postbuild": "node tools/audit-weather-bundle.mjs dist",
    "postbuild:android": "node tools/audit-weather-bundle.mjs dist-android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@photostructure/tz-lookup": "11.6.1",
    "@tikitaki_gagarinbefree/vue": "0.1.14",
    "@vue/devtools-api": "8.2.1",
    "bootstrap": "6.0.0-alpha.1",
    "pinia": "4.1.0",
    "tikitaki": "0.1.14",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
