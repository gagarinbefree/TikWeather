{
  "name": "tikweather",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:e2e": "playwright test",
    "test:e2e:connected": "node src/tests/run-connected-chrome.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tikitaki_gagarinbefree/vue": "0.1.14",
    "@vue/devtools-api": "8.2.1",
    "bootstrap": "6.0.0-alpha.1",
    "pinia": "4.1.0",
    "tikitaki": "0.1.14",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "vue-eslint-parser": "10.4.1"
  }
}
